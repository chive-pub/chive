{
  "lexicon": 1,
  "id": "pub.chive.richtext.facets",
  "revision": 1,
  "defs": {
    "bold": {
      "type": "object",
      "description": "Bold text formatting facet",
      "properties": {}
    },
    "italic": {
      "type": "object",
      "description": "Italic text formatting facet",
      "properties": {}
    },
    "strikethrough": {
      "type": "object",
      "description": "Strikethrough text formatting facet",
      "properties": {}
    },
    "code": {
      "type": "object",
      "description": "Inline code formatting facet",
      "properties": {}
    },
    "latex": {
      "type": "object",
      "description": "LaTeX math expression facet",
      "required": ["displayMode"],
      "properties": {
        "displayMode": {
          "type": "boolean",
          "description": "True for block display ($$...$$), false for inline ($...$)"
        }
      }
    },
    "heading": {
      "type": "object",
      "description": "Heading formatting facet",
      "required": ["level"],
      "properties": {
        "level": {
          "type": "integer",
          "description": "Heading level (1-6)",
          "minimum": 1,
          "maximum": 6
        }
      }
    },
    "blockquote": {
      "type": "object",
      "description": "Blockquote formatting facet",
      "properties": {}
    },
    "codeBlock": {
      "type": "object",
      "description": "Code block formatting facet",
      "properties": {
        "language": {
          "type": "string",
          "description": "Programming language for syntax highlighting",
          "maxLength": 50
        }
      }
    },
    "listItem": {
      "type": "object",
      "description": "List item formatting facet",
      "required": ["listType"],
      "properties": {
        "listType": {
          "type": "string",
          "description": "Type of list",
          "knownValues": ["bullet", "ordered"]
        },
        "depth": {
          "type": "integer",
          "description": "Nesting depth (0-indexed)",
          "minimum": 0,
          "maximum": 5
        },
        "ordinal": {
          "type": "integer",
          "description": "Item number for ordered lists",
          "minimum": 1
        }
      }
    }
  },
  "description": "$type is the protocol-level union discriminator; the Lexicon runtime supplies and checks it. Declaring it as an ordinary property made the code generator emit it twice and produced a duplicate-identifier error in every generated file for these defs — invisible while @ts-nocheck was applied to the whole generated tree."
}
