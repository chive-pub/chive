{
  "lexicon": 1,
  "id": "pub.chive.author.getProfile",
  "revision": 3,
  "defs": {
    "main": {
      "type": "query",
      "description": "Get author profile and metrics by DID",
      "parameters": {
        "type": "params",
        "required": ["did"],
        "properties": {
          "did": {
            "type": "string",
            "format": "did",
            "description": "Author DID"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["profile", "metrics"],
          "properties": {
            "profile": {
              "type": "ref",
              "ref": "#authorProfile"
            },
            "metrics": {
              "type": "ref",
              "ref": "#authorMetrics"
            },
            "sifa": {
              "type": "ref",
              "ref": "#sifaProfile"
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotFound"
        }
      ]
    },
    "authorProfile": {
      "type": "object",
      "required": ["did"],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "handle": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "avatar": {
          "type": "string",
          "format": "uri"
        },
        "bio": {
          "type": "string"
        },
        "bioRich": {
          "type": "array",
          "description": "Rich bio, the same item union reviews and abstracts use. `bio` holds its plain text.",
          "items": {
            "type": "union",
            "refs": [
              "pub.chive.richtext.defs#textItem",
              "pub.chive.richtext.defs#nodeRefItem",
              "pub.chive.richtext.defs#wikidataRefItem",
              "pub.chive.richtext.defs#fieldRefItem",
              "pub.chive.richtext.defs#facetRefItem",
              "pub.chive.richtext.defs#eprintRefItem",
              "pub.chive.richtext.defs#annotationRefItem",
              "pub.chive.richtext.defs#authorRefItem",
              "pub.chive.richtext.defs#mentionItem",
              "pub.chive.richtext.defs#linkItem",
              "pub.chive.richtext.defs#tagItem",
              "pub.chive.richtext.defs#latexItem",
              "pub.chive.richtext.defs#codeBlockItem",
              "pub.chive.richtext.defs#headingItem",
              "pub.chive.richtext.defs#listItem",
              "pub.chive.richtext.defs#blockquoteItem"
            ]
          }
        },
        "affiliation": {
          "type": "string"
        },
        "affiliations": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "pub.chive.defs#affiliation"
          }
        },
        "orcid": {
          "type": "string"
        },
        "orcidVerified": {
          "type": "boolean",
          "description": "Whether the author's ORCID has been verified via OAuth"
        },
        "website": {
          "type": "string",
          "format": "uri"
        },
        "pdsEndpoint": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nameVariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "previousAffiliations": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "pub.chive.defs#affiliation"
          }
        },
        "researchKeywords": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#researchKeyword"
          }
        },
        "semanticScholarId": {
          "type": "string"
        },
        "openAlexId": {
          "type": "string"
        },
        "googleScholarId": {
          "type": "string"
        },
        "arxivAuthorId": {
          "type": "string"
        },
        "openReviewId": {
          "type": "string"
        },
        "dblpId": {
          "type": "string"
        },
        "scopusAuthorId": {
          "type": "string"
        }
      }
    },
    "researchKeyword": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string"
        },
        "fastId": {
          "type": "string"
        },
        "wikidataId": {
          "type": "string"
        }
      }
    },
    "authorMetrics": {
      "type": "object",
      "required": ["totalEprints", "totalViews", "totalDownloads", "totalEndorsements"],
      "properties": {
        "totalEprints": {
          "type": "integer"
        },
        "totalViews": {
          "type": "integer"
        },
        "totalDownloads": {
          "type": "integer"
        },
        "totalEndorsements": {
          "type": "integer"
        }
      }
    },
    "sifaRole": {
      "type": "object",
      "description": "A role held at an institution, read from the researcher's own id.sifa.* records.",
      "required": ["institution", "source"],
      "properties": {
        "institution": {
          "type": "string",
          "description": "Institution or employer name."
        },
        "title": {
          "type": "string",
          "description": "Job title, or degree and field for education."
        },
        "institutionDid": {
          "type": "string",
          "format": "did",
          "description": "The institution's own DID, when sifa records one."
        },
        "startedAt": {
          "type": "string",
          "description": "ISO date the role began."
        },
        "endedAt": {
          "type": "string",
          "description": "ISO date the role ended. Absent means current."
        },
        "isPrimary": {
          "type": "boolean",
          "description": "Whether sifa marks this the primary position."
        },
        "source": {
          "type": "string",
          "description": "Which sifa collection this came from.",
          "knownValues": ["position", "education"]
        }
      }
    },
    "sifaProfile": {
      "type": "object",
      "description": "A researcher's sifa.id profile, read from their own repository. Chive never writes these records; they belong to the researcher.",
      "required": ["hasProfile"],
      "properties": {
        "hasProfile": {
          "type": "boolean",
          "description": "Whether the researcher has any sifa records."
        },
        "displayName": {
          "type": "string"
        },
        "headline": {
          "type": "string",
          "description": "One-line description of what the researcher does."
        },
        "about": {
          "type": "string"
        },
        "pronouns": {
          "type": "string"
        },
        "currentRoles": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#sifaRole"
          }
        },
        "previousRoles": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#sifaRole"
          }
        }
      }
    }
  }
}
