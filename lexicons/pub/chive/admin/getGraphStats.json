{
  "lexicon": 1,
  "id": "pub.chive.admin.getGraphStats",
  "revision": 1,
  "defs": {
    "main": {
      "type": "query",
      "description": "Get knowledge graph statistics",
      "parameters": {
        "type": "params",
        "properties": {}
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "totalNodes",
            "totalEdges",
            "fieldNodes",
            "authorNodes",
            "institutionNodes",
            "pendingProposals"
          ],
          "properties": {
            "totalNodes": {
              "type": "integer",
              "description": "Total knowledge graph nodes."
            },
            "totalEdges": {
              "type": "integer",
              "description": "Total knowledge graph edges."
            },
            "fieldNodes": {
              "type": "integer",
              "description": "Nodes of subkind field."
            },
            "authorNodes": {
              "type": "integer",
              "description": "Nodes of subkind author."
            },
            "institutionNodes": {
              "type": "integer",
              "description": "Nodes of subkind institution."
            },
            "pendingProposals": {
              "type": "integer",
              "description": "Proposals awaiting review."
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthenticationRequired"
        },
        {
          "name": "AdminRequired"
        }
      ]
    }
  }
}
