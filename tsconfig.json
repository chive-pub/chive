{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022"],
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    // Unused-symbol checking lives in ESLint, not here.
    //
    // `@typescript-eslint/no-unused-vars` already enforces this on hand-written
    // code and already ignores src/lexicons/generated. Leaving it on in tsc too
    // meant the generator's boilerplate — unused CID, $Typed and OmitKey
    // imports across 436 files — produced roughly a thousand diagnostics, which
    // was answered by prepending `// @ts-nocheck` to every generated file. That
    // exempted the whole lexicon type surface from type checking to silence a
    // lint concern, and hid two real schema errors for as long as it was there.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@/*": ["./src/*"],
      "@web/*": ["./web/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "scripts/**/*",
    "vitest.*.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  // `tests/e2e` is excluded because Playwright's types conflict with Vitest's
  // globals in the same program; it has its own typecheck.
  "exclude": ["node_modules", "dist", ".turbo", "tests/e2e"]
}
